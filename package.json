{
  "name": "spacevibe-deck",
  "private": true,
  "version": "0.12.3",
  "type": "module",
  "scripts": {
    "generate:menu": "tsx scripts/generate-menu.ts",
    "generate:menu:check": "tsx scripts/generate-menu.ts --check",
    "postinstall": "node scripts/fix-spawn-helper-permissions.mjs",
    "verify:windows-bundle": "node scripts/verify-windows-bundle.mjs",
    "test:updater-manifest": "node --test scripts/verify-updater-manifest.test.mjs",
    "predev": "npm run generate:menu",
    "prebuild": "npm run generate:menu",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:updater": "node scripts/capture-updater-preview.mjs",
    "prototype:gallery": "vite --host 127.0.0.1 --port 5175 --strictPort --open /gallery.html",
    "refresh:pricing": "node scripts/refresh-usage-pricing.mjs",
    "prototype:landing": "vite marketing --host 127.0.0.1 --port 5173 --strictPort --open /landing-prototype/",
    "build:landing": "vite build --config marketing/landing-prototype/vite.build.mjs",
    "video:preview": "vite marketing --host 127.0.0.1 --port 5174 --strictPort --open /video/",
    "video:render": "node marketing/video/render/render.mjs",
    "test": "vitest run --exclude scripts/verify-windows-bundle.test.mjs --exclude scripts/verify-updater-manifest.test.mjs --exclude scripts/ipc-contract.test.ts",
    "tauri": "tauri",
    "electron:build": "tsc -p tsconfig.electron.json && node scripts/build-electron-main.mjs",
    "build:gate-m-renderer": "vite build --config vite.gate-m.config.mjs",
    "electron:package:gate-m": "npm run build && npm run build:gate-m-renderer && npm run electron:build && electron-builder --config electron-builder.gate-m.yml --mac --universal --dir --publish never",
    "electron:verify:gate-m": "node scripts/verify-electron-gate-m-package.mjs",
    "electron:dev": "npm run build && npm run electron:build && electron dist-electron/electron/main.cjs",
    "electron:smoke": "npm run build && npm run electron:build && electron dist-electron/electron/smoke.cjs",
    "shoot": "npm run build && npm run electron:build && electron dist-electron/electron/shoot.cjs"
  },
  "dependencies": {
    "@preact/signals": "^2.9.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-preact": "^1.30.0",
    "monaco-editor": "0.56.0",
    "node-pty": "^1.1.0",
    "ogl": "^1.0.11",
    "preact": "^10.29.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.0",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
