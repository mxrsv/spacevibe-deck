{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "react_perf", "typescript", "import", "jest", "vitest"],
  "jsPlugins": ["./scripts/oxlint-plugin-deck/index.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-explicit-any": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "warn",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "warn",
    "eslint/no-underscore-dangle": "off",
    "import/no-duplicates": ["error", { "prefer-inline": true }],
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off",
    "max-lines": ["warn", 300],
    // React Compiler checks, on by default since oxlint 1.80. The renderer is Preact with
    // signals and no compiler, so their findings (mutating a ref, reading one in render)
    // describe idioms this code relies on, not bugs.
    "react/immutability": "off",
    "react/purity": "off",
    "react/refs": "off",
    "deck/require-suppression-reason": "error",
    "deck/no-unreasoned-skip": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The renderer reaches the main process only through src/host/ (overview.md)."
              },
              {
                "name": "node-pty",
                "message": "PTYs belong to the main process; the renderer goes through src/host/."
              }
            ],
            "patterns": [
              {
                "group": ["node:*"],
                "message": "The renderer runs without Node; ask the main process through src/host/."
              },
              {
                "regex": "^(\\.\\./)+electron/",
                "message": "The renderer must not import the main process; go through src/host/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "plugins": ["jest", "vitest"],
      "rules": {
        "no-explicit-any": "off",
        "no-restricted-imports": "off",
        "jest/expect-expect": "off",
        "vitest/expect-expect": "off",
        "jest/no-conditional-expect": "off",
        "vitest/no-conditional-expect": "off",
        "jest/valid-title": "off",
        "vitest/valid-title": "off",
        "vitest/require-mock-type-parameters": "off",
        "jest/valid-expect": ["error", { "maxArgs": 2 }],
        "vitest/valid-expect": ["error", { "maxArgs": 2 }]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".next/**",
    "coverage/**",
    ".turbo/**",
    "build/**",
    "www/**",
    "test-results/**",
    ".expo/**",
    "electron/vendor/**",
    "marketing/**"
  ]
}
