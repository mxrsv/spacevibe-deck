{
  "name": "spacevibe-deck-mobile-app",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "terminal-html": "node scripts/build-terminal-html.mjs",
    "postinstall": "npm run terminal-html",
    "prestart": "npm run terminal-html",
    "start": "expo start --go",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "../node_modules/.bin/oxlint -c ../.oxlintrc.json --deny-warnings src",
    "test": "vitest run",
    "bundle": "node scripts/bundle-check.mjs",
    "check": "npm run terminal-html && npm run typecheck && npm run lint && npm run test && npm run bundle",
    "start:dev-client": "expo start --dev-client"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@xterm/xterm": "^6.0.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
