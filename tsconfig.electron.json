{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  // `mobile/` is its own package with its own check (`npm run mobile:check`). Only the protocol
  // files `electron/mobile/` imports are compiled here, through that import, as the shared contract.
  "include": ["electron/**/*.ts", "src/terminal/action-registry.ts"],
  "exclude": ["electron/**/*.test.ts"]
}
