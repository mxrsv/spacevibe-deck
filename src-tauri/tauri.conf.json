{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceVibe Deck",
  "version": "0.12.2",
  "identifier": "dev.spacevibe.deck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SpaceVibe Deck",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "backgroundColor": "#16161e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "mxrsv",
    "copyright": "© 2026 mxrsv",
    "category": "DeveloperTool",
    "shortDescription": "A minimal desktop terminal for AI agent CLIs",
    "longDescription": "SpaceVibe Deck is a lightweight desktop terminal built with Tauri 2, xterm.js and Preact — designed for running AI agent CLIs like Claude Code, Codex and Gemini with split panes, themes and persistent settings.",
    "homepage": "https://github.com/mxrsv/spacevibe-deck",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
